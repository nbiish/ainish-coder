#!/bin/bash
# Main ainish-coder CLI tool
# Comprehensive configuration manager for AI coding assistants

set -euo pipefail

# Ensure we have a minimal PATH for basic commands
# This prevents issues if PATH is corrupted in the calling environment
if [[ ":$PATH:" != *":/usr/bin:"* ]] || [[ ":$PATH:" != *":/bin:"* ]]; then
    export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
fi

# Get script directory, resolving symlinks if necessary
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
SRC_DIR="${SCRIPT_DIR}/../src"

# Load shared shell components
source "${SRC_DIR}/colors.sh"
source "${SRC_DIR}/paths.sh"
# Windows bridge (path form + interpreter discovery); inert on Linux/macOS/WSL.
source "${SRC_DIR}/runtime.sh"
ainish_install_python_shim
source "${SRC_DIR}/file_operations.sh"
source "${SRC_DIR}/validation.sh"
source "${SRC_DIR}/backup.sh"
source "${SRC_DIR}/ignore_patterns.sh"

# Load deployment components
source "${SRC_DIR}/help.sh"
source "${SRC_DIR}/deploy_commands.sh"
source "${SRC_DIR}/deploy_agents.sh"
source "${SRC_DIR}/deploy_rules_sync.sh"
source "${SRC_DIR}/agents_protection.sh"

source "${SRC_DIR}/deploy_critical.sh"
source "${SRC_DIR}/deploy_gitignore.sh"
# Load ignore-file deployment components
source "${SRC_DIR}/deploy_github_actions.sh"
source "${SRC_DIR}/deploy_local_security.sh"
source "${SRC_DIR}/deploy_template_agent.sh"
source "${SRC_DIR}/deploy_skills.sh"
source "${SRC_DIR}/verify_skills.sh"
source "${SRC_DIR}/skills_selection.sh"
source "${SRC_DIR}/deploy_unlock.sh"
source "${SRC_DIR}/deploy_agents_comms.sh"
source "${SRC_DIR}/deploy_mcp_recipes.sh"
source "${SRC_DIR}/deploy_scrolls.sh"
source "${SRC_DIR}/scroll_integrity.sh"
source "${SRC_DIR}/deploy_license.sh"
source "${SRC_DIR}/deploy_signals.sh"
source "${SRC_DIR}/deploy_llms_txt.sh"
source "${SRC_DIR}/embed_config.sh"
source "${SRC_DIR}/pqc_dist.sh"

# Main function
main() {
    local command="$1"
    shift

    # --headless second argument: skip ALL prompts, apply the persisted
    # selection as-is. Agent/CI path: `ainish-coder --skills-sync <dir> --headless`
    # or `ainish-coder --rules <dir> --headless`.
    local AINISH_HEADLESS="${AINISH_HEADLESS:-false}"
    local args=()
    local a
    for a in "$@"; do
        if [[ "$a" == "--headless" ]]; then
            AINISH_HEADLESS="true"
        else
            args+=("$a")
        fi
    done
    if (( ${#args[@]} > 0 )); then set -- "${args[@]}"; else set --; fi
    export AINISH_HEADLESS

    # Get target directory (default to current directory, canonicalized)
    local _EXPLICIT_TARGET_DIR=""
    if [[ -n "${1:-}" ]]; then
        _EXPLICIT_TARGET_DIR="$1"
    fi
    local target_dir="${1:-$(pwd)}"
    if [[ -d "$target_dir" ]]; then
        target_dir="$(cd -P "$target_dir" 2>/dev/null && pwd)"
    fi

    # Prompt user for deploy destination base (home vs target dir)
    # Echoes "$HOME" or "$target_dir" to stdout
    _pick_dest_base() {
        if [[ -n "${_EXPLICIT_TARGET_DIR:-}" ]]; then
            echo "$target_dir"
            return
        fi

        # If non-interactive mode OR not in interactive mode, default to target_dir
        if [[ "${AINISH_NON_INTERACTIVE:-false}" == "true" ]] || [[ "${AINISH_INTERACTIVE:-false}" != "true" ]] || [[ ! -t 0 ]]; then
            echo "$target_dir"
            return
        fi

        while true; do
            echo -e "Where would you like to deploy?" >&2
            echo -e "  1) Home directory (~)/" >&2
            echo -e "  2) Current/Target directory ($target_dir)" >&2
            echo -ne "${BRIGHT_YELLOW}▸ ${RESET}Enter choice [1 or 2, default: 2]: " >&2
            local choice
            read -r choice || true
            choice=$(echo "$choice" | xargs)
            if [[ -z "$choice" ]]; then
                echo "$target_dir"
                return
            elif [[ "$choice" == "1" ]]; then
                echo "$HOME"
                return
            elif [[ "$choice" == "2" ]]; then
                echo "$target_dir"
                return
            else
                echo "Invalid choice. Please enter 1 or 2." >&2
            fi
        done
    }

    # Ask if user wants to symlink from repo source (single source of truth).
    # Returns 0 if symlink, 1 if copy. Respects global -l flag.
    # Defaults to copy (n) — safer, avoids accidental source modification.
    _confirm_symlink() {
        if [[ "${AINISH_LINK_MODE:-false}" == "true" ]]; then
            return 0  # Already set globally via -l
        fi
        # If non-interactive mode OR not in interactive mode, default to copy (safer)
        if [[ "${AINISH_NON_INTERACTIVE:-false}" == "true" ]] || [[ "${AINISH_INTERACTIVE:-false}" != "true" ]] || [[ ! -t 0 ]]; then
            return 1  # Default to copy (safer default)
        fi
        confirm_action "Symlink from repo source (single source of truth)?" "n"
    }

    # Run a deploy function, optionally overriding AINISH_LINK_MODE for just
    # this call based on user preference. Pass the deploy command + args.
    _with_link_choice() {
        if _confirm_symlink; then
            AINISH_LINK_MODE="true" "$@"
        else
            AINISH_LINK_MODE="false" "$@"
        fi
    }

    # Deploy the optional skill packs for the rules bundle.
    #
    # `--rules` distributes coordination/runtime logic unconditionally, but the
    # `.agents/skills/` packs are optional prompt surface and must be the
    # operator's choice. The selector is therefore offered once per repo and
    # then governed by the persisted selection, so:
    #   * a first run can never silently deploy zero packs (the fdd8537
    #     default-off flip made that the silent outcome), and
    #   * repeat runs and CI stay deterministic with no prompt.
    # Whatever happens, an interrupted selector cancels to the persisted
    # selection instead of stalling or skipping skill deployment entirely.
    _rules_deploy_skills() {
        local target_dir="$1"

        # The source repo already owns every pack; there is nothing to choose
        # and nothing to distribute, so skip the selector entirely.
        local target_canon source_canon
        target_canon="$(cd -P "$target_dir" 2>/dev/null && pwd || printf '%s' "$target_dir")"
        source_canon="$(cd -P "${REPO_DIR}" 2>/dev/null && pwd || printf '%s' "${REPO_DIR}")"
        if [[ -n "$target_canon" && "$target_canon" == "$source_canon" ]]; then
            deploy_skills "$target_dir"
            _TRACK_DETAIL="${_TRACK_DETAIL}+skills-source"
            return 0
        fi

        local mode
        mode="$(skills_selection_ui_mode)"

        local prompted=false
        if [[ "$mode" != "never" ]] && skills_selection_should_prompt "$target_dir"; then
            echo -e "${BRIGHT_BLUE}Skill packs are optional — choose what this repo should receive${RESET}"
            if _skills_toggle_ui "$target_dir"; then
                prompted=true
            else
                echo -e "${YELLOW}Selection unchanged — deploying the saved selection instead.${RESET}"
                echo -e "${YELLOW}Re-run 'ainish-coder --select-skills $target_dir' to choose again.${RESET}"
            fi
        elif [[ "$mode" == "auto" ]]; then
            echo -e "${BRIGHT_CYAN}✓ Skill packs: using the saved selection for this repo (change with 'ainish-coder --select-skills $target_dir')${RESET}"
        fi

        if _confirm_symlink; then
            AINISH_LINK_MODE="true" deploy_skills "$target_dir" || \
                print_warning "Skills deployment reported errors — continuing with remaining rules steps"
        else
            AINISH_LINK_MODE="false" deploy_skills "$target_dir" || \
                print_warning "Skills deployment reported errors — continuing with remaining rules steps"
        fi

        # A zero-pack result is a legitimate choice, but it must never look like
        # an accident: name the command that changes it.
        if [[ "$(skills_selection_enabled_count "$target_dir")" == "0" ]]; then
            echo -e "${YELLOW}ℹ No optional skill packs selected for this repo.${RESET}"
            echo -e "  Choose packs with: ${BRIGHT_WHITE}ainish-coder --select-skills $target_dir${RESET}"
        fi

        if [[ "$prompted" == "true" ]]; then
            _TRACK_DETAIL="${_TRACK_DETAIL}+skills-selected"
        else
            _TRACK_DETAIL="${_TRACK_DETAIL}+skills-persisted"
        fi
    }

    # Deploy the full rules bundle. Shared by --rules and the auto-sync refresher
    # so one code path keeps every target repository in sync.
    deploy_rules_bundle() {
        local target_dir="$1"
        _TRACK_DETAIL="AGENTS.md+gitignore"
        echo -e "${BRIGHT_BLUE}Deploying Rules System to: $target_dir${RESET}"

        if confirm_action "Deploy the universal AGENTS.md (repo-agnostic standard; llms.txt remains the per-repo PRD)?" "y"; then
            deploy_agents "$target_dir"
        fi

        # Ensure global AGENTS.md copies are always fresh
        deploy_agents_global

        if confirm_action "Deploy/merge .gitignore configuration to: $target_dir?" "y"; then
            _with_link_choice deploy_gitignore "$target_dir"
        fi

        # Seed the PRD template only when the target has none: never overwrite a
        # repository's own llms.txt DOX chain.
        if [[ ! -f "$target_dir/llms.txt" && -f "${REPO_DIR}/src/templates/llms.txt" ]]; then
            cp "${REPO_DIR}/src/templates/llms.txt" "$target_dir/llms.txt" || true
            chmod 644 "$target_dir/llms.txt" 2>/dev/null || true
            echo -e "${GREEN}✓ Seeded llms.txt PRD template (existing PRDs are never overwritten)${RESET}"
        fi

        # ── Skill packs ──────────────────────────────────────────────────
        # Coordination/runtime logic already shipped above; this step only
        # distributes the OPTIONAL .agents/skills/ packs, so it must ask.
        # Three bounded paths, never a hang:
        #   always -> operator asked for the selector (--select-skills, or a
        #             first-contact repo on a real TTY): open the toggle UI,
        #             persist, then deploy exactly what was chosen.
        #   never  -> headless/CI/non-TTY: apply the persisted selection as-is.
        #   auto   -> selector cancelled/timed out: deploy the persisted
        #             selection so the run still completes deterministically.
        _rules_deploy_skills "$target_dir"

        # Agent Communication System — .agents/comms/{date}-team.txt (one per UTC date)
        # Merge-safe: refreshes protocol template, preserves agent entries.
        if confirm_action "Deploy Agent Communication System (.agents/comms/{date}-team.txt)?" "y"; then
            deploy_agents_comms "$target_dir"
            _TRACK_DETAIL="${_TRACK_DETAIL}+agents-comms"
        fi

        # Ensure workspace customizations root (.agents/tasks, .agents/suggestions, .agents/rag, .agents/audit, .agents/wiki, .agents/memories) is scaffolded
        mkdir -p "$target_dir/.agents/tasks" "$target_dir/.agents/suggestions" "$target_dir/.agents/rag" "$target_dir/.agents/audit" "$target_dir/.agents/wiki" "$target_dir/.agents/memories" 2>/dev/null || true

        # Detect PQC/environment embedding credentials (OpenRouter/ZenMux) and route the RAG
        # engine's embeddings through them; nothing is persisted when no credentials exist.
        if confirm_action "Detect remote embedding credentials (OpenRouter/ZenMux via PQC) and configure RAG?" "y"; then
            deploy_embed_provider_detect "$target_dir" || \
                print_warning "Embedding provider detection reported errors — local embeddings remain active"
            _TRACK_DETAIL="${_TRACK_DETAIL}+embed-provider"
        fi

        # Arm continuous auto-sync (manifest + refresher + git hooks + fleet registry)
        if ! deploy_rules_sync "$target_dir"; then
            print_error "Auto-sync deployment failed; refusing to report an unsigned or unverifiable rules deployment"
            return 1
        fi

        echo -e "${BRIGHT_GREEN}✅ Rules deployment complete${RESET}"
    }

    case "$command" in
        --help|-h)
            show_help
            ;;
        --version|-v)
            show_version
            ;;

        # Commands deployment
        --commands)
            if [[ $# -eq 0 ]]; then
                print_error "Missing argument for --commands"
                echo "Usage: ainish-coder --commands {tool}" >&2
                echo "Example: ainish-coder --commands cursor" >&2
                exit 1
            fi
            deploy_commands "$1"
            ;;



        # Core rules deployment
        --rules)
            deploy_rules_bundle "$target_dir"
            ;;

        --rules-sync)
            local _all=false _quiet=false _gc=false _json=false _sync_target=""
            local _a
            for _a in "$@"; do
                case "$_a" in
                    --all) _all=true ;;
                    --quiet|-q) _quiet=true ;;
                    --gc) _gc=true ;;
                    --json) _json=true ;;
                    --*) ;;
                    *) _sync_target="$_a" ;;
                esac
            done
            if [[ "$_all" == "true" ]]; then
                rules_sync_all "$_quiet" "$_gc" "$_json"
            elif [[ "$_gc" == "true" ]]; then
                rules_sync_all "$_quiet" "$_gc" "$_json"
            else
                rules_sync_target "${_sync_target:-$(pwd)}"
            fi
            ;;

        --rules-status)
            local _json=false _a
            for _a in "$@"; do [[ "$_a" == "--json" ]] && _json=true; done
            rules_status "$_json"
            ;;

        --rules-verify)
            rules_verify "$@"
            ;;

        --rules-provenance)
            rules_provenance_stamp "$@"
            ;;

        --rules-rotate)
            rules_rotate "$@"
            ;;

        --rules-history)
            rules_history "$@"
            ;;

        --embed-config)
            embed_config "$@"
            ;;

        --rules-unenroll)
            rules_unenroll "$@"
            ;;

        --rules-doctor)
            rules_doctor "$@"
            ;;

        --rules-watch)
            rules_watch "${1:-30}"
            ;;

        --agents)
            _TRACK_DETAIL="AGENTS.md"
            if confirm_action "Deploy the universal AGENTS.md (repo-agnostic standard; llms.txt remains the per-repo PRD)?" "y"; then
                local agents_dest="$(_pick_dest_base)"
                deploy_agents "$agents_dest"
            fi

            # Ensure global AGENTS.md copies are always fresh
            deploy_agents_global
            ;;

        # Security files deployment
        --secure)
            _TRACK_DETAIL="AGENTS_CODE+LLM_SECURITY"
            echo -e "${BRIGHT_BLUE}Deploying Agents Security Files${RESET}"

            if confirm_action "Deploy AGENTS_CODE_SECURITY.md (code security standards)?" "y"; then
                local code_security_source="${REPO_DIR}/.agents/skills/code-security/references/production-standards.md"
                if [[ ! -f "$code_security_source" ]]; then
                     code_security_source="${REPO_DIR}/AGENTS_CODE_SECURITY.md"
                fi
                if [[ -f "$code_security_source" ]]; then
                     _with_link_choice deploy_path "$code_security_source" "$target_dir/AGENTS_CODE_SECURITY.md"
                     echo -e "${GREEN}✓ AGENTS_CODE_SECURITY.md at $target_dir${RESET}"
                else
                     echo -e "${BRIGHT_RED}Error: AGENTS_CODE_SECURITY.md not found at $code_security_source${RESET}"
                fi
            fi

            if confirm_action "Deploy AGENTS_LLM_SECURITY.md (LLM/agentic security standards)?" "y"; then
                local llm_security_source="${REPO_DIR}/.agents/skills/llm-security/references/production-standards.md"
                if [[ ! -f "$llm_security_source" ]]; then
                     llm_security_source="${REPO_DIR}/AGENTS_LLM_SECURITY.md"
                fi
                if [[ -f "$llm_security_source" ]]; then
                     _with_link_choice deploy_path "$llm_security_source" "$target_dir/AGENTS_LLM_SECURITY.md"
                     echo -e "${GREEN}✓ AGENTS_LLM_SECURITY.md at $target_dir${RESET}"
                else
                     echo -e "${BRIGHT_RED}Error: AGENTS_LLM_SECURITY.md not found at $llm_security_source${RESET}"
                fi
            fi

            echo -e "${BRIGHT_GREEN}✅ Agents security deployment complete${RESET}"
            ;;


        # Template Agent System
        --template-agent)
            _TRACK_DETAIL="template-agent"
            if confirm_action "Deploy template agent files to: $target_dir?" "y"; then
                _with_link_choice deploy_template_agent "$target_dir"
            fi
            ;;

        # Utility deployments
        --critical)
            _TRACK_DETAIL="critical.md"
            if confirm_action "Deploy critical repository standards (critical.md, assets, funding) to: $target_dir?" "y"; then
                _with_link_choice deploy_critical "$target_dir"
            fi
            ;;
        --gitignore)
            _TRACK_DETAIL="gitignore"
            if confirm_action "Deploy/merge .gitignore configuration?" "y"; then
                _with_link_choice deploy_gitignore "$target_dir"
            fi
            ;;
        --github-actions)
            _TRACK_DETAIL="github-actions"
            if confirm_action "Deploy secure GitHub Actions workflow templates?" "y"; then
                _with_link_choice deploy_github_actions "$target_dir"
            fi
            ;;
        --local-security)
            _TRACK_DETAIL="local-security"
            if confirm_action "Deploy local security hooks and checking scripts?" "y"; then
                _with_link_choice deploy_local_security "$target_dir"
            fi
            ;;

        --mcp-recipes)
            _TRACK_DETAIL="mcp-recipes"
            if confirm_action "Deploy MCP server configuration recipes?" "y"; then
                _with_link_choice deploy_mcp_recipes "$target_dir"
            fi
            ;;

        --unlock)
            _TRACK_DETAIL="pliny-unlock"
            if confirm_action "Unlock repository (deploy ref-codebases, research collections, pliny)?" "y"; then
                local unlock_dest="$(_pick_dest_base)"
                _with_link_choice deploy_unlock "$unlock_dest"
            fi
            ;;

        --skills-verify)
            verify_ainish_skills "${target_dir}"
            ;;

        # Explicit skill-selection surfaces. `--rules` offers the selector on
        # first contact; these commands make the same choice available on
        # demand, plus a read-only view of what is currently selected.
        --select-skills)
            _TRACK_DETAIL="select-skills"
            local _sel_target _sel_used=""
            for _sel_target in "$@"; do
                case "$_sel_target" in
                    -*) continue ;;
                esac
                _sel_used="$_sel_target"
                break
            done
            _sel_target="${_sel_used:-$(pwd)}"
            if [[ -d "$_sel_target" ]]; then
                _sel_target="$(cd -P "$_sel_target" 2>/dev/null && pwd)"
            fi
            if [[ "${AINISH_HEADLESS:-false}" == "true" ]] || [[ "${AINISH_NON_INTERACTIVE:-false}" == "true" ]]; then
                print_error "--select-skills needs an interactive terminal; use '--rules <dir> --headless' with a saved selection instead"
                exit 1
            elif ! skills_selection_tty_ok; then
                print_error "--select-skills needs an interactive terminal (no TTY detected)"
                exit 1
            elif _skills_toggle_ui "$_sel_target"; then
                echo -e "${BRIGHT_GREEN}✅ Saved. Deploy the chosen packs with: ainish-coder --rules $_sel_target${RESET}"
            else
                echo -e "${YELLOW}Selection unchanged.${RESET}"
            fi
            ;;

        --skills-list)
            _TRACK_DETAIL="skills-list"
            local _list_arg _list_target="" _list_json=false
            for _list_arg in "$@"; do
                case "$_list_arg" in
                    --json) _list_json=true ;;
                    -*) ;;
                    *) [[ -z "$_list_target" ]] && _list_target="$_list_arg" ;;
                esac
            done
            _list_target="${_list_target:-$(pwd)}"
            if [[ -d "$_list_target" ]]; then
                _list_target="$(cd -P "$_list_target" 2>/dev/null && pwd)"
            fi
            skills_selection_report "$_list_target" "$_list_json"
            ;;

        --skills-sync)
            if [[ "${AINISH_HEADLESS:-false}" == "true" ]] || \
               [[ "${AINISH_NON_INTERACTIVE:-false}" == "true" ]] || ! skills_selection_tty_ok; then
                # Headless/CI path: persisted selection governs; no prompts.
                sync_ainish_skills "${target_dir}"
                _TRACK_DETAIL="skills-sync-headless"
            else
                # A real terminal IS the interactive path: toggle UI first —
                # add/remove packs to sync here; choices persist for every
                # future --rules/--skills-sync.
                if _skills_toggle_ui "$target_dir"; then
                    if _confirm_symlink; then
                        AINISH_LINK_MODE="true" sync_ainish_skills "$target_dir"
                    else
                        AINISH_LINK_MODE="false" sync_ainish_skills "$target_dir"
                    fi
                    _TRACK_DETAIL="skills-sync-selected"
                else
                    echo -e "${YELLOW}No selection saved — syncing the saved selection instead.${RESET}"
                    sync_ainish_skills "${target_dir}"
                    _TRACK_DETAIL="skills-sync-persisted"
                fi
            fi
            ;;

        --scrolls)
            # Explicit-only deployment: never bundled with --rules, --llms-txt,
            # or any other command. Scrolls are adversarial-prompting/ghost-layer
            # deployment payload for targeted publishing — distributed into a
            # repo ONLY when the operator calls this command directly.
            # Requires a live interactive confirmation: confirm_action
            # auto-confirms defaults unless interactive mode AND a TTY.
            if [[ "${AINISH_INTERACTIVE:-false}" != "true" ]] || [[ ! -t 0 ]]; then
                print_error "--scrolls requires an interactive terminal: run 'ainish-coder -i --scrolls <dir>' and confirm the prompt"
                exit 1
            fi
            _TRACK_DETAIL="scrolls"
            # Verify-first gate: verify the SOURCE payload (REPO_DIR/.scrolls)
            # before any bytes move; the manifest travels with the deployed copy
            # so downstream consumers re-verify. Re-sign touches the SOURCE only.
            local scrolls_payload="${REPO_DIR}/.scrolls"
            local scrolls_verify_rc=0
            scrolls_verify "$scrolls_payload" || scrolls_verify_rc=$?
            if [[ $scrolls_verify_rc -ne 0 ]]; then
                if [[ "${AINISH_NON_INTERACTIVE:-false}" == "true" ]]; then
                    print_error "Scroll verification failed; refusing deploy: $(scrolls_verify "$scrolls_payload" 2> /dev/null || true)"
                    scrolls_comms_log "deploy-failed" "verify-first gate refused deploy to $target_dir" "$scrolls_payload"
                    exit 1
                fi
                print_warning "Scroll verification failed for: $scrolls_payload"
                if confirm_action "Re-sign (manifest + ML-DSA-65 signature) and retry? Seeds must be set via AINISHCODER_SCROLL_SIGN_SEED." "n"; then
                    if scrolls_sign "$scrolls_payload" && scrolls_verify "$scrolls_payload"; then
                        scrolls_comms_log "intent-deploy" "re-signed payload, proceeding to deploy" "$scrolls_payload"
                    else
                        print_error "Re-sign/verify failed; refusing deploy"
                        scrolls_comms_log "deploy-failed" "re-sign attempt failed verify gate" "$scrolls_payload"
                        exit 1
                    fi
                else
                    scrolls_comms_log "deploy-failed" "operator declined re-sign; deploy refused" "$scrolls_payload"
                    print_error "Refusing to deploy unverified scrolls"
                    exit 1
                fi
            fi
            if confirm_action "Deploy scrolls (adversarial-prompting/ghost-layer payload) to: $target_dir?" "y"; then
                scrolls_comms_log "intent-deploy" "operator confirmed deploy to $target_dir" "$target_dir/.scrolls"
                _with_link_choice deploy_scrolls "$target_dir"
                scrolls_comms_log "deployed" "scroll payload deployed to $target_dir" "$target_dir/.scrolls"
            fi
            ;;

        --scrolls-manifest)
            _TRACK_DETAIL="scrolls-manifest"
            scrolls_manifest "$target_dir"
            ;;

        --scrolls-sign)
            _TRACK_DETAIL="scrolls-sign"
            local scrolls_council_arg=""
            if [[ "${2:-}" == "--council" ]]; then
                scrolls_council_arg="--council"
                shift
            fi
            scrolls_sign "$target_dir" $scrolls_council_arg
            ;;

        --scrolls-verify)
            _TRACK_DETAIL="scrolls-verify"
            local scrolls_target="${target_dir}/.scrolls"
            [[ -d "$scrolls_target" ]] || scrolls_target="$target_dir"
            if scrolls_verify "$scrolls_target"; then
                echo -e "${GREEN}PASS${RESET}"
            else
                echo -e "${RED}FAIL${RESET}"
                exit 1
            fi
            ;;

        --license)
            _TRACK_DETAIL="LICENSE"
            if confirm_action "Deploy LICENSE and governing legal framework to: $target_dir?" "y"; then
                _with_link_choice deploy_license "$target_dir"
            fi
            ;;

        --signals)
            _TRACK_DETAIL="signals"
            local deploy_examples="false"
            local real_target="$target_dir"

            # Check if "ai" argument was passed (captured as target_dir by main)
            if [[ "$target_dir" == "ai" ]]; then
                deploy_examples="true"
                # If "ai" was the first arg, check if user provided a target dir as the second arg
                if [[ -n "${2:-}" ]]; then
                    real_target="$2"
                else
                    real_target="$(pwd)"
                fi
            fi

            if confirm_action "Deploy signals monitoring framework to: $real_target?" "y"; then
                _with_link_choice deploy_signals "$real_target" "$deploy_examples"
            fi
            ;;

        --llms-txt)
            _TRACK_DETAIL="llms.txt"
            local llms_dest="$target_dir"
            if [[ "${AINISH_INTERACTIVE:-false}" == "true" && -t 0 ]]; then
                if confirm_action "Deploy llms.txt file?" "y"; then
                    llms_dest="$(_pick_dest_base)"
                    _with_link_choice deploy_llms_txt "$llms_dest"
                fi
            else
                _with_link_choice deploy_llms_txt "$llms_dest"
            fi
            ;;

        --lock-rules)
            _TRACK_DETAIL="lock-rules"
            echo -e "${BRIGHT_BLUE}Locking root AGENTS.md (write-protection active)...${RESET}"
            if lock_agents_contract "${REPO_DIR}/AGENTS.md"; then
                snapshot_canonical_contract "${REPO_DIR}/AGENTS.md" 2>/dev/null || true
                echo -e "${BRIGHT_GREEN}🔒 AGENTS.md is now write-protected (read-only).${RESET}"
                echo -e "   To edit in root repo: ainish-coder --edit-rules (or --unlock-rules)"
            else
                print_error "Failed to lock AGENTS.md"
                exit 1
            fi
            ;;

        --unlock-rules)
            _TRACK_DETAIL="unlock-rules"
            echo -e "${YELLOW}Unlocking root AGENTS.md for authorized editing...${RESET}"
            if unlock_agents_contract "${REPO_DIR}/AGENTS.md"; then
                echo -e "${GREEN}🔓 AGENTS.md is now writable.${RESET}"
                echo -e "${YELLOW}⚠️  Remember to re-lock when finished: ainish-coder --lock-rules${RESET}"
            else
                print_error "Failed to unlock AGENTS.md"
                exit 1
            fi
            ;;

        --edit-rules)
            _TRACK_DETAIL="edit-rules"
            echo -e "${BRIGHT_BLUE}Opening root AGENTS.md for authorized editing...${RESET}"
            unlock_agents_contract "${REPO_DIR}/AGENTS.md" || true
            local editor_cmd="${EDITOR:-}"
            if [[ -z "$editor_cmd" ]]; then
                if command -v code >/dev/null 2>&1; then
                    editor_cmd="code --wait"
                elif command -v nano >/dev/null 2>&1; then
                    editor_cmd="nano"
                elif command -v vim >/dev/null 2>&1; then
                    editor_cmd="vim"
                elif command -v vi >/dev/null 2>&1; then
                    editor_cmd="vi"
                elif [[ "$(uname -s 2>/dev/null)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
                    editor_cmd="open -W -t"
                elif command -v notepad.exe >/dev/null 2>&1; then
                    editor_cmd="notepad.exe"
                fi
            fi
            if [[ -n "$editor_cmd" ]]; then
                $editor_cmd "${REPO_DIR}/AGENTS.md" || true
            else
                echo -e "${YELLOW}No editor found. Please edit ${REPO_DIR}/AGENTS.md and run ainish-coder --lock-rules when done.${RESET}"
            fi
            snapshot_canonical_contract "${REPO_DIR}/AGENTS.md" 2>/dev/null || true
            lock_agents_contract "${REPO_DIR}/AGENTS.md" || true
            echo -e "${BRIGHT_GREEN}🔒 Editing session finished. AGENTS.md re-locked and snapshotted.${RESET}"
            ;;

        --restore-rules)
            _TRACK_DETAIL="restore-rules"
            restore_canonical_contract "${REPO_DIR}/AGENTS.md"
            ;;

        --verify-rules)
            _TRACK_DETAIL="verify-rules"
            echo -e "${BRIGHT_BLUE}Verifying AGENTS.md integrity and copy status...${RESET}"
            local check_dir="${1:-.}"
            local target_agents="${check_dir}/AGENTS.md"
            local root_agents="${REPO_DIR}/AGENTS.md"

            # Check root integrity
            if verify_canonical_contract "$root_agents"; then
                echo -e "${GREEN}✓ Root AGENTS.md matches canonical snapshot${RESET}"
            else
                echo -e "${BRIGHT_RED}❌ Root AGENTS.md integrity mismatch! Run ainish-coder --restore-rules to fix.${RESET}"
            fi

            # Check root lock status (optional; copy deployment keeps root writable)
            if is_agents_contract_locked "$root_agents"; then
                echo -e "${YELLOW}ℹ️  Root AGENTS.md is OS-locked. Unlock with: ainish-coder --unlock-rules${RESET}"
            else
                echo -e "${GREEN}✓ Root AGENTS.md is writable at the single source of truth${RESET}"
            fi

            # If target dir provided and exists, check target copy freshness
            if [[ -e "$target_agents" || -L "$target_agents" ]]; then
                if [[ -L "$target_agents" ]]; then
                    echo -e "${YELLOW}⚠️  Target AGENTS.md ($target_agents) is a legacy symlink. Run ainish-coder --rules $check_dir to convert it to a tracked copy.${RESET}"
                elif cmp -s "$root_agents" "$target_agents"; then
                    echo -e "${GREEN}✓ Target AGENTS.md ($target_agents) is an up-to-date copy of root${RESET}"
                else
                    echo -e "${YELLOW}⚠️  Target AGENTS.md ($target_agents) differs from root. Run ainish-coder --rules $check_dir to refresh the copy.${RESET}"
                fi
            fi
            ;;

        --pqc-install)
            _TRACK_DETAIL="pqc-install"
            pqc_install "$@"
            ;;

        --pqc-status)
            _TRACK_DETAIL="pqc-status"
            pqc_status "$@"
            ;;

        --pqc-sync-targets)
            _TRACK_DETAIL="pqc-sync"
            pqc_sync_targets "$@"
            ;;

        --rag)            _TRACK_DETAIL="rag"
            "${SCRIPT_DIR}/ainish-rag" "$@"
            ;;

        *)
            print_error "Unknown command: $command"
            echo "Use 'ainish-coder --help' for usage information" >&2
            exit 1
            ;;
    esac
}

# Parse global flags
export AINISH_NON_INTERACTIVE="false"
export AINISH_INTERACTIVE="false"
export AINISH_LINK_MODE="false"
export AINISH_NO_OVERWRITE="false"
filtered_args=()
for arg in "$@"; do
    if [[ "$arg" == "-y" || "$arg" == "--yes" || "$arg" == "--non-interactive" ]]; then
        export AINISH_NON_INTERACTIVE="true"
    elif [[ "$arg" == "-i" || "$arg" == "--interactive" ]]; then
        export AINISH_INTERACTIVE="true"
    elif [[ "$arg" == "-l" || "$arg" == "--link" ]]; then
        export AINISH_LINK_MODE="true"
    elif [[ "$arg" == "-n" || "$arg" == "--no-overwrite" ]]; then
        export AINISH_NO_OVERWRITE="true"
    else
        filtered_args+=("$arg")
    fi
done

if [[ ${#filtered_args[@]} -gt 0 ]]; then
    set -- "${filtered_args[@]}"
fi

# ── Usage tracking (EXIT trap) ────────────────────────────────────────────────
# Logs the ainish-coder invocation to ~/.cache/ainish-coder/usage.csv on exit.
# _TRACK_DETAIL is set by individual handlers (e.g. --skills) to capture the
# specific skill or agent that was deployed, giving granular per-operation data.
_TRACK_DETAIL=""
if [[ "${AINISH_NO_TRACKING:-false}" != "true" ]]; then
  _TRACK_START=$(python3 -c "import time; print(int(time.time()*1000))" 2>/dev/null || echo 0)
  _track_on_exit() {
    local rc=$?
    # EXIT traps are inherited by command-substitution subshells. Tracking
    # from those subshells can re-enter external tooling and stall deployment.
    if [[ "${BASH_SUBSHELL:-0}" -gt 0 ]]; then
      trap - EXIT
      exit $rc
    fi
    local now
    now=$(python3 -c "import time; print(int(time.time()*1000))" 2>/dev/null || echo 0)
    local tracker_bin
    tracker_bin="$(command -v cmd-tracker 2>/dev/null || true)"
    if [[ -n "$tracker_bin" && -x "$tracker_bin" ]]; then
      local subcmd="${1:-}"
      local detail="${_TRACK_DETAIL:-}"
      "$tracker_bin" "ainish-coder" "${subcmd}${detail:+,${detail}}" "" -- true 2>/dev/null || true
    fi
    exit $rc
  }
  trap '_track_on_exit "${1:-}"' EXIT
  # Save the first arg (subcommand) before main shifts it
  _TRACK_SUBCMD="${1:-}"
fi

# Check if at least one argument provided
if [[ $# -eq 0 ]]; then
    print_error "No command specified"
    echo "Use 'ainish-coder --help' for usage information" >&2
    exit 1
fi

# Normalise Windows-style path arguments (D:\project, D:/project, \\server\share)
# to POSIX form so every absolute-path check downstream holds. Path-less flags
# pass through untouched; on Linux/macOS/WSL this loop is a no-op.
if ainish_is_windows; then
    _ainish_argv=()
    for _ainish_arg in "$@"; do
        _ainish_argv+=("$(ainish_posix_path "$_ainish_arg")")
    done
    set -- "${_ainish_argv[@]}"
    unset _ainish_argv _ainish_arg
fi

# Run main function
main "$@"
