#!/bin/bash
# Main ainish-coder CLI tool
# Comprehensive configuration manager for AI coding assistants

set -euo pipefail

# Ensure we have a minimal PATH for basic commands
# This prevents issues if PATH is corrupted in the calling environment
if [[ ":$PATH:" != *":/usr/bin:"* ]] || [[ ":$PATH:" != *":/bin:"* ]]; then
    export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
fi

# Get script directory, resolving symlinks if necessary
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
SRC_DIR="${SCRIPT_DIR}/../src"

# Load shared shell components
source "${SRC_DIR}/colors.sh"
source "${SRC_DIR}/paths.sh"
source "${SRC_DIR}/file_operations.sh"
source "${SRC_DIR}/validation.sh"
source "${SRC_DIR}/backup.sh"
source "${SRC_DIR}/ignore_patterns.sh"

# Load deployment components
source "${SRC_DIR}/help.sh"
source "${SRC_DIR}/deploy_commands.sh"
source "${SRC_DIR}/deploy_agents.sh"

source "${SRC_DIR}/deploy_critical.sh"
source "${SRC_DIR}/deploy_gitignore.sh"
# Load ignore-file deployment components
source "${SRC_DIR}/deploy_github_actions.sh"
source "${SRC_DIR}/deploy_local_security.sh"
source "${SRC_DIR}/deploy_template_agent.sh"
source "${SRC_DIR}/deploy_skills.sh"
source "${SRC_DIR}/verify_skills.sh"
source "${SRC_DIR}/skills_selection.sh"
source "${SRC_DIR}/deploy_unlock.sh"
source "${SRC_DIR}/deploy_agents_comms.sh"
source "${SRC_DIR}/deploy_mcp_recipes.sh"
source "${SRC_DIR}/deploy_scrolls.sh"
source "${SRC_DIR}/scroll_integrity.sh"
source "${SRC_DIR}/deploy_license.sh"
source "${SRC_DIR}/deploy_signals.sh"
source "${SRC_DIR}/deploy_llms_txt.sh"

# Main function
main() {
    local command="$1"
    shift

    # --headless second argument: skip ALL prompts, apply the persisted
    # selection as-is. Agent/CI path: `ainish-coder --skills <dir> --headless`
    # or `ainish-coder --rules <dir> --headless`.
    local AINISH_HEADLESS="${AINISH_HEADLESS:-false}"
    local args=()
    local a
    for a in "$@"; do
        if [[ "$a" == "--headless" ]]; then
            AINISH_HEADLESS="true"
        else
            args+=("$a")
        fi
    done
    if (( ${#args[@]} > 0 )); then set -- "${args[@]}"; else set --; fi
    export AINISH_HEADLESS

    # Get target directory (default to current directory, canonicalized)
    local _EXPLICIT_TARGET_DIR=""
    if [[ -n "${1:-}" ]]; then
        _EXPLICIT_TARGET_DIR="$1"
    fi
    local target_dir="${1:-$(pwd)}"
    if [[ -d "$target_dir" ]]; then
        target_dir="$(cd -P "$target_dir" 2>/dev/null && pwd)"
    fi

    # Prompt user for deploy destination base (home vs target dir)
    # Echoes "$HOME" or "$target_dir" to stdout
    _pick_dest_base() {
        if [[ -n "${_EXPLICIT_TARGET_DIR:-}" ]]; then
            echo "$target_dir"
            return
        fi

        # If non-interactive mode OR not in interactive mode, default to target_dir
        if [[ "${AINISH_NON_INTERACTIVE:-false}" == "true" ]] || [[ "${AINISH_INTERACTIVE:-false}" != "true" ]] || [[ ! -t 0 ]]; then
            echo "$target_dir"
            return
        fi

        while true; do
            echo -e "Where would you like to deploy?" >&2
            echo -e "  1) Home directory (~)/" >&2
            echo -e "  2) Current/Target directory ($target_dir)" >&2
            echo -ne "${BRIGHT_YELLOW}▸ ${RESET}Enter choice [1 or 2, default: 2]: " >&2
            local choice
            read -r choice || true
            choice=$(echo "$choice" | xargs)
            if [[ -z "$choice" ]]; then
                echo "$target_dir"
                return
            elif [[ "$choice" == "1" ]]; then
                echo "$HOME"
                return
            elif [[ "$choice" == "2" ]]; then
                echo "$target_dir"
                return
            else
                echo "Invalid choice. Please enter 1 or 2." >&2
            fi
        done
    }

    # Ask if user wants to symlink from repo source (single source of truth).
    # Returns 0 if symlink, 1 if copy. Respects global -l flag.
    # Defaults to copy (n) — safer, avoids accidental source modification.
    _confirm_symlink() {
        if [[ "${AINISH_LINK_MODE:-false}" == "true" ]]; then
            return 0  # Already set globally via -l
        fi
        # If non-interactive mode OR not in interactive mode, default to copy (safer)
        if [[ "${AINISH_NON_INTERACTIVE:-false}" == "true" ]] || [[ "${AINISH_INTERACTIVE:-false}" != "true" ]] || [[ ! -t 0 ]]; then
            return 1  # Default to copy (safer default)
        fi
        confirm_action "Symlink from repo source (single source of truth)?" "n"
    }

    # Run a deploy function, optionally overriding AINISH_LINK_MODE for just
    # this call based on user preference. Pass the deploy command + args.
    _with_link_choice() {
        if _confirm_symlink; then
            AINISH_LINK_MODE="true" "$@"
        else
            AINISH_LINK_MODE="false" "$@"
        fi
    }

    case "$command" in
        --help|-h)
            show_help
            ;;
        --version|-v)
            show_version
            ;;

        # Commands deployment
        --commands)
            if [[ $# -eq 0 ]]; then
                print_error "Missing argument for --commands"
                echo "Usage: ainish-coder --commands {tool}" >&2
                echo "Example: ainish-coder --commands cursor" >&2
                exit 1
            fi
            deploy_commands "$1"
            ;;



        # Core rules deployment
        --rules)
            _TRACK_DETAIL="AGENTS.md+gitignore"
            echo -e "${BRIGHT_BLUE}Deploying Rules System to: $target_dir${RESET}"

            if confirm_action "Deploy the universal AGENTS.md (repo-agnostic standard; llms.txt remains the per-repo PRD)?" "y"; then
                _with_link_choice deploy_agents "$target_dir"
            fi

            # Ensure global AGENTS.md symlinks are always correct
            deploy_agents_global

            if confirm_action "Deploy/merge .gitignore configuration to: $target_dir?" "y"; then
                _with_link_choice deploy_gitignore "$target_dir"
            fi

            if [[ "${AINISH_HEADLESS:-false}" == "true" ]]; then
                # Headless: persisted selection governs; no prompts.
                deploy_skills "$target_dir" || \
                    print_warning "Skills deployment reported errors — continuing with remaining rules steps"
                _TRACK_DETAIL="${_TRACK_DETAIL}+skills-headless"
            elif confirm_action "Deploy skill packs (.agents/skills/) per your saved selection?" "y"; then
                # Interactive: open the toggle UI first so this run's choices
                # persist for every future --rules/--skills/--skills-sync.
                _skills_toggle_ui "$target_dir" && {
                    if _confirm_symlink; then
                        AINISH_LINK_MODE="true" deploy_skills "$target_dir" || \
                            print_warning "Skills deployment reported errors — continuing with remaining rules steps"
                    else
                        AINISH_LINK_MODE="false" deploy_skills "$target_dir" || \
                            print_warning "Skills deployment reported errors — continuing with remaining rules steps"
                    fi
                }
                _TRACK_DETAIL="${_TRACK_DETAIL}+skills-selected"
            fi

            # Agent Communication System — AGENTS/{date}.COMMS.md
            # Merge-safe: refreshes protocol template, preserves agent entries.
            if confirm_action "Deploy Agent Communication System (AGENTS/{date}.COMMS.md)?" "y"; then
                deploy_agents_comms "$target_dir"
                _TRACK_DETAIL="${_TRACK_DETAIL}+agents-comms"
            fi

            # Ensure workspace customizations root (.agents/tasks) is scaffolded
            mkdir -p "$target_dir/.agents/tasks" 2>/dev/null || true

            echo -e "${BRIGHT_GREEN}✅ Rules deployment complete${RESET}"
            ;;

        --agents)
            _TRACK_DETAIL="AGENTS.md"
            if confirm_action "Deploy the universal AGENTS.md (repo-agnostic standard; llms.txt remains the per-repo PRD)?" "y"; then
                local agents_dest="$(_pick_dest_base)"
                _with_link_choice deploy_agents "$agents_dest"
            fi

            # Ensure global AGENTS.md symlinks are always correct
            deploy_agents_global
            ;;

        # Security files deployment
        --secure)
            _TRACK_DETAIL="AGENTS_CODE+LLM_SECURITY"
            echo -e "${BRIGHT_BLUE}Deploying Agents Security Files${RESET}"

            if confirm_action "Deploy AGENTS_CODE_SECURITY.md (code security standards)?" "y"; then
                local code_security_source="${REPO_DIR}/.agents/skills/code-security/references/production-standards.md"
                if [[ ! -f "$code_security_source" ]]; then
                     code_security_source="${REPO_DIR}/AGENTS_CODE_SECURITY.md"
                fi
                if [[ -f "$code_security_source" ]]; then
                     _with_link_choice deploy_path "$code_security_source" "$target_dir/AGENTS_CODE_SECURITY.md"
                     echo -e "${GREEN}✓ AGENTS_CODE_SECURITY.md at $target_dir${RESET}"
                else
                     echo -e "${BRIGHT_RED}Error: AGENTS_CODE_SECURITY.md not found at $code_security_source${RESET}"
                fi
            fi

            if confirm_action "Deploy AGENTS_LLM_SECURITY.md (LLM/agentic security standards)?" "y"; then
                local llm_security_source="${REPO_DIR}/.agents/skills/llm-security/references/production-standards.md"
                if [[ ! -f "$llm_security_source" ]]; then
                     llm_security_source="${REPO_DIR}/AGENTS_LLM_SECURITY.md"
                fi
                if [[ -f "$llm_security_source" ]]; then
                     _with_link_choice deploy_path "$llm_security_source" "$target_dir/AGENTS_LLM_SECURITY.md"
                     echo -e "${GREEN}✓ AGENTS_LLM_SECURITY.md at $target_dir${RESET}"
                else
                     echo -e "${BRIGHT_RED}Error: AGENTS_LLM_SECURITY.md not found at $llm_security_source${RESET}"
                fi
            fi

            echo -e "${BRIGHT_GREEN}✅ Agents security deployment complete${RESET}"
            ;;


        # Template Agent System
        --template-agent)
            _TRACK_DETAIL="template-agent"
            if confirm_action "Deploy template agent files to: $target_dir?" "y"; then
                _with_link_choice deploy_template_agent "$target_dir"
            fi
            ;;

        # Utility deployments
        --critical)
            _TRACK_DETAIL="critical.md"
            if confirm_action "Deploy critical.md (essential repository rules)?" "y"; then
                _with_link_choice deploy_critical "$target_dir"
            fi
            ;;
        --gitignore)
            _TRACK_DETAIL="gitignore"
            if confirm_action "Deploy/merge .gitignore configuration?" "y"; then
                _with_link_choice deploy_gitignore "$target_dir"
            fi
            ;;
        --github-actions)
            _TRACK_DETAIL="github-actions"
            if confirm_action "Deploy secure GitHub Actions workflow templates?" "y"; then
                _with_link_choice deploy_github_actions "$target_dir"
            fi
            ;;
        --local-security)
            _TRACK_DETAIL="local-security"
            if confirm_action "Deploy local security hooks and checking scripts?" "y"; then
                _with_link_choice deploy_local_security "$target_dir"
            fi
            ;;

        --mcp-recipes)
            _TRACK_DETAIL="mcp-recipes"
            if confirm_action "Deploy MCP server configuration recipes?" "y"; then
                _with_link_choice deploy_mcp_recipes "$target_dir"
            fi
            ;;

        --unlock)
            _TRACK_DETAIL="pliny-unlock"
            if confirm_action "Unlock repository (deploy ref-codebases, research collections, pliny)?" "y"; then
                local unlock_dest="$(_pick_dest_base)"
                _with_link_choice deploy_unlock "$unlock_dest"
            fi
            ;;

        --skills-verify)
            verify_ainish_skills "${target_dir}"
            ;;

        --skills-sync)
            if [[ "${AINISH_HEADLESS:-false}" == "true" ]]; then
                # Headless: persisted selection governs; no prompts.
                sync_ainish_skills "${target_dir}"
            elif [[ "${AINISH_NON_INTERACTIVE:-false}" != "true" && -t 0 ]]; then
                # A real terminal IS the interactive path: toggle UI first —
                # add/remove packs to sync here; choices persist for every
                # future --skills/--rules/--skills-sync.
                if _skills_toggle_ui "$target_dir"; then
                    sync_ainish_skills "${target_dir}"
                else
                    echo -e "${YELLOW}Sync aborted (no selection saved).${RESET}"
                    _TRACK_DETAIL="sync-aborted"
                fi
            else
                # Non-interactive default: apply persisted config as-is.
                sync_ainish_skills "${target_dir}"
            fi
            ;;

        --skills)
            if [[ "${AINISH_HEADLESS:-false}" == "true" ]]; then
                # Headless: persisted selection governs; no prompts.
                deploy_skills "$target_dir"
                _TRACK_DETAIL="skills-headless"
            elif [[ "${AINISH_NON_INTERACTIVE:-false}" != "true" && -t 0 ]]; then
                # A real terminal IS the interactive path: open the
                # node-choice toggle UI — pick the packs this repo receives;
                # selection persists across terminals. (-y/--headless bypass.)
                if _skills_toggle_ui "$target_dir"; then
                    if _confirm_symlink; then
                        AINISH_LINK_MODE="true" deploy_skills "$target_dir"
                    else
                        AINISH_LINK_MODE="false" deploy_skills "$target_dir"
                    fi
                    _TRACK_DETAIL="skills-selected"
                else
                    echo -e "${YELLOW}Deploy aborted (no selection saved).${RESET}"
                    _TRACK_DETAIL="aborted"
                fi
            else
                # Non-interactive default: apply persisted config as-is.
                deploy_skills "$target_dir"
                _TRACK_DETAIL="skills-persisted"
            fi
            ;;

        --scrolls)
            # Explicit-only deployment: never bundled with --rules, --llms-txt,
            # or any other command. Scrolls are adversarial-prompting/ghost-layer
            # deployment payload for targeted publishing — distributed into a
            # repo ONLY when the operator calls this command directly.
            # Requires a live interactive confirmation: confirm_action
            # auto-confirms defaults unless interactive mode AND a TTY.
            if [[ "${AINISH_INTERACTIVE:-false}" != "true" ]] || [[ ! -t 0 ]]; then
                print_error "--scrolls requires an interactive terminal: run 'ainish-coder -i --scrolls <dir>' and confirm the prompt"
                exit 1
            fi
            _TRACK_DETAIL="scrolls"
            # Verify-first gate: verify the SOURCE payload (REPO_DIR/.scrolls)
            # before any bytes move; the manifest travels with the deployed copy
            # so downstream consumers re-verify. Re-sign touches the SOURCE only.
            local scrolls_payload="${REPO_DIR}/.scrolls"
            local scrolls_verify_rc=0
            scrolls_verify "$scrolls_payload" || scrolls_verify_rc=$?
            if [[ $scrolls_verify_rc -ne 0 ]]; then
                if [[ "${AINISH_NON_INTERACTIVE:-false}" == "true" ]]; then
                    print_error "Scroll verification failed; refusing deploy: $(scrolls_verify "$scrolls_payload" 2> /dev/null || true)"
                    scrolls_comms_log "deploy-failed" "verify-first gate refused deploy to $target_dir" "$scrolls_payload"
                    exit 1
                fi
                print_warning "Scroll verification failed for: $scrolls_payload"
                if confirm_action "Re-sign (manifest + ML-DSA-65 signature) and retry? Seeds must be set via AINISHCODER_SCROLL_SIGN_SEED." "n"; then
                    if scrolls_sign "$scrolls_payload" && scrolls_verify "$scrolls_payload"; then
                        scrolls_comms_log "intent-deploy" "re-signed payload, proceeding to deploy" "$scrolls_payload"
                    else
                        print_error "Re-sign/verify failed; refusing deploy"
                        scrolls_comms_log "deploy-failed" "re-sign attempt failed verify gate" "$scrolls_payload"
                        exit 1
                    fi
                else
                    scrolls_comms_log "deploy-failed" "operator declined re-sign; deploy refused" "$scrolls_payload"
                    print_error "Refusing to deploy unverified scrolls"
                    exit 1
                fi
            fi
            if confirm_action "Deploy scrolls (adversarial-prompting/ghost-layer payload) to: $target_dir?" "y"; then
                scrolls_comms_log "intent-deploy" "operator confirmed deploy to $target_dir" "$target_dir/.scrolls"
                _with_link_choice deploy_scrolls "$target_dir"
                scrolls_comms_log "deployed" "scroll payload deployed to $target_dir" "$target_dir/.scrolls"
            fi
            ;;

        --scrolls-manifest)
            _TRACK_DETAIL="scrolls-manifest"
            scrolls_manifest "$target_dir"
            ;;

        --scrolls-sign)
            _TRACK_DETAIL="scrolls-sign"
            local scrolls_council_arg=""
            if [[ "${2:-}" == "--council" ]]; then
                scrolls_council_arg="--council"
                shift
            fi
            scrolls_sign "$target_dir" $scrolls_council_arg
            ;;

        --scrolls-verify)
            _TRACK_DETAIL="scrolls-verify"
            local scrolls_target="${target_dir}/.scrolls"
            [[ -d "$scrolls_target" ]] || scrolls_target="$target_dir"
            if scrolls_verify "$scrolls_target"; then
                echo -e "${GREEN}PASS${RESET}"
            else
                echo -e "${RED}FAIL${RESET}"
                exit 1
            fi
            ;;

        --license)
            _TRACK_DETAIL="LICENSE"
            if confirm_action "Deploy LICENSE to: $target_dir?" "y"; then
                _with_link_choice deploy_license "$target_dir"
            fi
            ;;

        --signals)
            _TRACK_DETAIL="signals"
            local deploy_examples="false"
            local real_target="$target_dir"

            # Check if "ai" argument was passed (captured as target_dir by main)
            if [[ "$target_dir" == "ai" ]]; then
                deploy_examples="true"
                # If "ai" was the first arg, check if user provided a target dir as the second arg
                if [[ -n "${2:-}" ]]; then
                    real_target="$2"
                else
                    real_target="$(pwd)"
                fi
            fi

            if confirm_action "Deploy signals monitoring framework to: $real_target?" "y"; then
                _with_link_choice deploy_signals "$real_target" "$deploy_examples"
            fi
            ;;

        --llms-txt)
            _TRACK_DETAIL="llms.txt"
            local llms_dest="$target_dir"
            if [[ "${AINISH_INTERACTIVE:-false}" == "true" && -t 0 ]]; then
                if confirm_action "Deploy llms.txt file?" "y"; then
                    llms_dest="$(_pick_dest_base)"
                    _with_link_choice deploy_llms_txt "$llms_dest"
                fi
            else
                _with_link_choice deploy_llms_txt "$llms_dest"
            fi
            ;;

        *)
            print_error "Unknown command: $command"
            echo "Use 'ainish-coder --help' for usage information" >&2
            exit 1
            ;;
    esac
}

# Parse global flags
export AINISH_NON_INTERACTIVE="false"
export AINISH_INTERACTIVE="false"
export AINISH_LINK_MODE="false"
export AINISH_NO_OVERWRITE="false"
filtered_args=()
for arg in "$@"; do
    if [[ "$arg" == "-y" || "$arg" == "--yes" || "$arg" == "--non-interactive" ]]; then
        export AINISH_NON_INTERACTIVE="true"
    elif [[ "$arg" == "-i" || "$arg" == "--interactive" ]]; then
        export AINISH_INTERACTIVE="true"
    elif [[ "$arg" == "-l" || "$arg" == "--link" ]]; then
        export AINISH_LINK_MODE="true"
    elif [[ "$arg" == "-n" || "$arg" == "--no-overwrite" ]]; then
        export AINISH_NO_OVERWRITE="true"
    else
        filtered_args+=("$arg")
    fi
done

if [[ ${#filtered_args[@]} -gt 0 ]]; then
    set -- "${filtered_args[@]}"
fi

# ── Usage tracking (EXIT trap) ────────────────────────────────────────────────
# Logs the ainish-coder invocation to ~/.cache/ainish-coder/usage.csv on exit.
# _TRACK_DETAIL is set by individual handlers (e.g. --skills) to capture the
# specific skill or agent that was deployed, giving granular per-operation data.
_TRACK_DETAIL=""
if [[ "${AINISH_NO_TRACKING:-false}" != "true" ]]; then
  _TRACK_START=$(python3 -c "import time; print(int(time.time()*1000))" 2>/dev/null || echo 0)
  _track_on_exit() {
    local rc=$?
    local now
    now=$(python3 -c "import time; print(int(time.time()*1000))" 2>/dev/null || echo 0)
    local tracker_bin
    tracker_bin="$(command -v cmd-tracker 2>/dev/null || true)"
    if [[ -n "$tracker_bin" && -x "$tracker_bin" ]]; then
      local subcmd="${1:-}"
      local detail="${_TRACK_DETAIL:-}"
      "$tracker_bin" "ainish-coder" "${subcmd}${detail:+,${detail}}" "" -- true 2>/dev/null || true
    fi
    exit $rc
  }
  trap '_track_on_exit "${1:-}"' EXIT
  # Save the first arg (subcommand) before main shifts it
  _TRACK_SUBCMD="${1:-}"
fi

# Check if at least one argument provided
if [[ $# -eq 0 ]]; then
    print_error "No command specified"
    echo "Use 'ainish-coder --help' for usage information" >&2
    exit 1
fi

# Run main function
main "$@"
