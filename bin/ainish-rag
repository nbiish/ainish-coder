#!/usr/bin/env bash
# ainish-rag — Cross-platform platform dispatch wrapper for Multimodal Codebase RAG & Wiki Engine
# Supports Windows (Git Bash/MSYS2), WSL (Windows Subsystem for Linux), native Linux, and macOS (Darwin)
# Uses EmbeddingGemma-2 GGUF (768-d) + LanceDB hybrid vector database
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SELF_PATH="$SELF_DIR/$(basename "$SOURCE")"
PY_ENGINE="$SELF_DIR/../src/rag/rag.py"

# The candidates below are named "ainish-rag" / "ainish-rag.exe" and sit next to this script, so a
# bare existence test can select THIS launcher as the "native binary" and exec it recursively — an
# unbounded self-exec that produces no output and never terminates. It bit every host whose
# preferred binary was absent: Linux fell through to ./ainish-rag (itself), and the unknown-OS and
# Git Bash branches did the same. Compare real paths, not names, before accepting a candidate.
is_self() {
    [ -n "${1:-}" ] || return 1
    [ "$(cd -P "$(dirname "$1")" 2>/dev/null && pwd)/$(basename "$1")" = "$SELF_PATH" ]
}

OS_TYPE="$(uname -s 2>/dev/null || echo "Unknown")"
NATIVE_BIN=""

case "$OS_TYPE" in
  Darwin*)
    [ -f "$SELF_DIR/ainish-rag-darwin" ] && NATIVE_BIN="$SELF_DIR/ainish-rag-darwin"
    if [ -z "$NATIVE_BIN" ] && [ -f "$SELF_DIR/ainish-rag" ] && [ -x "$SELF_DIR/ainish-rag" ] && ! is_self "$SELF_DIR/ainish-rag"; then
      NATIVE_BIN="$SELF_DIR/ainish-rag"
    fi
    ;;
  Linux*)
    # Native Linux or WSL
    [ -f "$SELF_DIR/ainish-rag-linux" ] && NATIVE_BIN="$SELF_DIR/ainish-rag-linux"
    if [ -z "$NATIVE_BIN" ] && [ -f "$SELF_DIR/ainish-rag" ] && [ -x "$SELF_DIR/ainish-rag" ] && ! is_self "$SELF_DIR/ainish-rag"; then
      NATIVE_BIN="$SELF_DIR/ainish-rag"
    fi
    # In WSL, if no Linux ELF binary, check for Windows .exe via interop
    if [ -z "$NATIVE_BIN" ] && grep -qi microsoft /proc/version 2>/dev/null && [ -f "$SELF_DIR/ainish-rag.exe" ]; then
      NATIVE_BIN="$SELF_DIR/ainish-rag.exe"
    fi
    ;;
  MINGW*|MSYS*|CYGWIN*)
    [ -f "$SELF_DIR/ainish-rag.exe" ] && NATIVE_BIN="$SELF_DIR/ainish-rag.exe"
    if [ -z "$NATIVE_BIN" ] && [ -f "$SELF_DIR/ainish-rag" ] && ! is_self "$SELF_DIR/ainish-rag"; then
      NATIVE_BIN="$SELF_DIR/ainish-rag"
    fi
    ;;
  *)
    if [ -f "$SELF_DIR/ainish-rag" ] && [ -x "$SELF_DIR/ainish-rag" ] && ! is_self "$SELF_DIR/ainish-rag"; then
      NATIVE_BIN="$SELF_DIR/ainish-rag"
    fi
    [ -z "$NATIVE_BIN" ] && [ -f "$SELF_DIR/ainish-rag.exe" ] && NATIVE_BIN="$SELF_DIR/ainish-rag.exe"
    ;;
esac

# 1. Execute native binary if found, executable, and not this launcher (see is_self above).
#
#    A compiled build can lag the Python engine by design (the exe is a gitignored artifact). When a
#    subcommand exists only in Python, exec'ing the stale binary turns a supported verb into
#    "unrecognized subcommand". Ask the binary's own --help once for the verbs it actually accepts and
#    fall through to Python for anything it does not advertise. PY_ONLY_SUBCOMMANDS is the escape
#    hatch for verbs added to Python ahead of a rebuild.
PY_ONLY_SUBCOMMANDS=" context council secrets "
FIRST_ARG=""
for a in "$@"; do
    case "$a" in
        -*) continue ;;
        *)  FIRST_ARG="$a"; break ;;
    esac
done
if [ -n "$NATIVE_BIN" ] && [ -x "$NATIVE_BIN" ] && ! is_self "$NATIVE_BIN"; then
    native_ok=1
    if [ -n "$FIRST_ARG" ]; then
        native_help="$("$NATIVE_BIN" --help 2>/dev/null || true)"
        if [ -n "$native_help" ] && ! printf '%s' "$native_help" | grep -qE "^[[:space:]]+$FIRST_ARG([[:space:]]|$)"; then
            native_ok=0
        fi
        case "$PY_ONLY_SUBCOMMANDS" in
            *" $FIRST_ARG "*) native_ok=0 ;;
        esac
    fi
    if [ "$native_ok" = "1" ]; then
        exec "$NATIVE_BIN" "$@"
    fi
fi

# 2. Transparent fallback to Python engine with uv / python3 / python
if command -v uv >/dev/null 2>&1; then
    exec uv run "$PY_ENGINE" "$@"
elif [ -f "$HOME/.local/bin/uv" ]; then
    exec "$HOME/.local/bin/uv" run "$PY_ENGINE" "$@"
elif [ -f "$HOME/.cargo/bin/uv" ]; then
    exec "$HOME/.cargo/bin/uv" run "$PY_ENGINE" "$@"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$PY_ENGINE" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$PY_ENGINE" "$@"
elif command -v py >/dev/null 2>&1; then
    exec py "$PY_ENGINE" "$@"
else
    echo "Error: Neither compiled binary ($NATIVE_BIN) nor uv/python3 was found." >&2
    exit 1
fi
