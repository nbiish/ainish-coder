{
  "format": "ainish-rag/master-surfaces/v1",
  "contract_paths": [
    "agents.md",
    "llms.txt",
    ".agents/canonical/",
    ".agents/skills/",
    "skills-to-distribute/",
    "src/templates/"
  ],
  "schema_suffixes": [
    "embed-provider.json",
    "index-fingerprint.json",
    "gate-status.json",
